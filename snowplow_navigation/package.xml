<?xml version="1.0"?>
<package format="3">
  <name>snowplow_navigation</name>
  <version>1.0.0</version>
  <description>Nav2 click-to-go navigation for the snowplow Gazebo simulation.</description>
  <maintainer email="2535854358@qq.com">Mingrxc</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
